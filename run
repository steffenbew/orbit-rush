#!/usr/bin/env bash
set -euo pipefail

cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")"

test() {
  local full="$1"
  shift
  if [[ $# -eq 0 ]]; then set -- tests/*.mjs; fi
  ORBIT_TEST_FULL="$full" exec node --test -- "$@"
}

deploy() {
  bash "$PWD/scripts/deploy.sh"
}

usage() {
  printf '%s\n' \
    'Usage: ./run {setup|start|dev|stop|build|preview|test|test:full|deploy|help}' \
    '' \
    '  setup       Install locked development dependencies (Node.js 22.12+)' \
    '  start, dev  Serve with Vite live refresh' \
    '  stop        Stop only this checkout’s tracked server' \
    '  build       Generate the static production site in dist/' \
    '  preview     Serve dist/ locally, including its production worker' \
    '  test        Run fast regression suites (optional: pass test file paths)' \
    '  test:full   Run wider gameplay sweeps and the starfield soak (optional: pass test file paths)' \
    '  deploy      Deploy to https://orbitrush.steffenbew.com (SSH/rsync)' \
    '  help        Show this help' \
    '' \
    'Defaults: start on 8080, preview on 8081, or a free port if occupied.' \
    'Custom port: PORT=8082 ./run start (fails if that port is occupied)' \
    'Stop with Ctrl+C or ./run stop in another terminal.'
}

if [[ $# -gt 1 && "$1" != test && "$1" != test:full ]]; then
  usage >&2
  exit 1
fi

case "${1:-help}" in
  setup) exec npm ci ;;
  start|dev) exec node scripts/dev-server.mjs start ;;
  stop|preview) exec node scripts/dev-server.mjs "$1" ;;
  build) exec node scripts/build.mjs ;;
  test) shift; test 0 "$@" ;;
  test:full) shift; test 1 "$@" ;;
  deploy) deploy ;;
  help|--help|-h) usage ;;
  *) usage >&2; exit 1 ;;
esac
