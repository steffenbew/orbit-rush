#!/usr/bin/env bash
set -euo pipefail

cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")"

start() {
  exec python3 "$PWD/scripts/dev-server.py" start
}

stop() {
  exec python3 "$PWD/scripts/dev-server.py" stop
}

test() {
  ORBIT_TEST_FULL="${1:-0}" node --test --test-concurrency=6 tests/*.mjs
}

deploy() {
  bash "$PWD/scripts/deploy.sh"
}

usage() {
  printf '%s\n' \
    'Usage: ./run {start|dev|stop|test|test:full|deploy|help}' \
    '' \
    '  start, dev  Serve locally in the foreground (Python 3)' \
    '  stop        Stop only this checkout’s tracked server' \
    '  test        Run fast regression suites (Python 3 and Node.js 20+)' \
    '  test:full   Also run exhaustive traversals and the five-minute starfield soak' \
    '  deploy      Deploy to https://orbitrush.steffenbew.com (SSH/rsync)' \
    '  help        Show this help' \
    '' \
    'Default: port 8080, or a free port if occupied; prints the actual URL.' \
    'Custom port: PORT=8082 ./run start (fails if that port is occupied)' \
    'Stop with Ctrl+C or ./run stop in another terminal.'
}

if [[ $# -gt 1 ]]; then
  usage >&2
  exit 1
fi

case "${1:-help}" in
  start|dev) start ;;
  stop) stop ;;
  test) test ;;
  test:full) test 1 ;;
  deploy) deploy ;;
  help|--help|-h) usage ;;
  *) usage >&2; exit 1 ;;
esac
