#!/usr/bin/env bash
set -euo pipefail

cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")"

test() {
  ORBIT_TEST_FULL="${1:-0}" node --test --test-concurrency=6 tests/*.mjs
}

deploy() {
  bash "$PWD/scripts/deploy.sh"
}

usage() {
  printf '%s\n' \
    'Usage: ./run {start|dev|stop|build|preview|test|test:full|deploy|help}' \
    '' \
    '  start, dev  Serve with Vite live refresh (npm ci first; Node.js 22.12+)' \
    '  stop        Stop only this checkout’s tracked server' \
    '  build       Generate the static production site in dist/' \
    '  preview     Serve dist/ locally, including its production worker' \
    '  test        Run fast regression suites' \
    '  test:full   Run wider gameplay sweeps and the five-minute simulated starfield soak' \
    '  deploy      Deploy to https://orbitrush.steffenbew.com (SSH/rsync)' \
    '  help        Show this help' \
    '' \
    'Defaults: start on 8080, preview on 8081, or a free port if occupied.' \
    'Custom port: PORT=8082 ./run start (fails if that port is occupied)' \
    'Stop with Ctrl+C or ./run stop in another terminal.'
}

if [[ $# -gt 1 ]]; then
  usage >&2
  exit 1
fi

case "${1:-help}" in
  start|dev) exec node scripts/dev-server.mjs start ;;
  stop|preview) exec node scripts/dev-server.mjs "$1" ;;
  build) exec node scripts/build.mjs ;;
  test) test ;;
  test:full) test 1 ;;
  deploy) deploy ;;
  help|--help|-h) usage ;;
  *) usage >&2; exit 1 ;;
esac
