Options -Indexes
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Stable entry points revalidate. Only cache Vite’s hashed files indefinitely, not legacy assets/audio/ or assets/vendor/.
  Header set Cache-Control "no-cache"
  Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#/assets/[^/]+-[A-Za-z0-9_-]{8}\.[^/]+$#"
</IfModule>
